{
    "name": "tuklas/tuklas",
    "type": "project",
    "description": "Tuklas career intelligence platform",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "laravel/jetstream": "^5.0",
        "laravel/sanctum": "^4.0",
        "inertiajs/inertia-laravel": "^2.0",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.25",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" }
    },
    "scripts": {
        "post-autoload-dump": ["@php artisan package:discover --ansi"],
        "setup": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\"", "@php artisan key:generate", "@php artisan migrate --force"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
