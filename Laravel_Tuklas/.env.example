APP_NAME=Tuklas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tuklas.test
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_PREVIOUS_KEYS=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=tuklas_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
CACHE_PREFIX=tuklas-cache-
FILESYSTEM_DISK=local
VITE_DEV_SERVER=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tuklas
DB_USERNAME=postgres
DB_PASSWORD=
DATABASE_URL=
DB_SSLMODE=prefer

GOOGLE_AI_API_KEY=
GEMINI_MODELS=gemini-3.7-flash,gemini-3.1-pro-preview
AUTH_FIELD_SECRET=
AUTH_OTP_REQUIRED=false
AUTH_TEST_ACCOUNTS=juan@tuklas.ph,maria@tuklas.ph,test@test.com,admin@tuklas.ph
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_RESET_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
VITE_AUTH_REDIRECT_URI=http://127.0.0.1:8000/auth
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional Redis configuration. File cache/session storage works locally.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# Optional database cache settings when CACHE_STORE=database.
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=cache_locks
VIEW_COMPILED_PATH=
